ENVIRONMENT=development
RUN_MODE=full
DB_DRIVER=postgres
DB_SOURCE=postgresql://user:password@localhost:5432/dbname?sslmode=disable
MIGRATION_URL=file://db/migration
REDIS_ADDR=localhost:6379
HTTP_SERVER_ADDRESS=0.0.0.0:6060
GRPC_SERVER_ADDRESS=0.0.0.0:7070
TOKEN_SYMMETRIC_KEY=your_32_byte_symmetric_key_here
ACCESS_TOKEN_DURATION=15m   
REFRESH_TOKEN_DURATION=24h
SHIRO_JID=your_shiro_jid_here
PRICE_PER_KWH=0.53
EMAIL_SENDER_NAME=YourName
EMAIL_SENDER_ADDRESS=your_email@example.com
EMAIL_SENDER_PASSWORD=your_email_password
USERNAME=admin
PASSWORD=your_admin_password
FULL_NAME=Administrator
EMAIL=admin@example.com
DETECT_LOW_BALANCE_CRON="10 * * * *"
FETCH_SURPLUS_CRON="5 * * * *"
BACKEND_DOMAIN=http://api.yourdomain.com
PROXY_GRPC_ADDRESS=localhost:7070
REDIS_LIMITER_CAPACITY=20
REDIS_LIMITER_RATE=10
